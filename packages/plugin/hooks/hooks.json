{
  "$schema": "https://code.claude.com/schemas/hooks.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "SessionStart"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "PreToolUse"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "PostToolUse"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "PostToolUseFailure"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "Stop"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://causalist.xyz/api/ingest/$CAUSALIST_SESSION",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer $CAUSALIST_TOKEN",
              "Content-Type": "application/json",
              "X-Causalist-Event": "SessionEnd"
            },
            "allowedEnvVars": ["CAUSALIST_SESSION", "CAUSALIST_TOKEN"],
            "timeout": 4
          }
        ]
      }
    ]
  }
}
